# ═══════════════════════════════════════════════
#  🎯 KAZI HUNTER — Configuration
#  Copie ce fichier en .env et adapte les valeurs
# ═══════════════════════════════════════════════

# ── 👤 Ton profil ────────────────────────────────
CANDIDATE_NAME=TonPrenom
TARGET_JOB=DevOps Engineer
CONTRACT_TYPE=CDI

# ── 📍 Localisation ──────────────────────────────
LOCATION=France

# ── 🔍 Mots-clés recherche ───────────────────────
KEYWORDS=DevOps,Cloud,Kubernetes,Docker,Terraform,CI/CD

# ── 🚫 Mots-clés à exclure ───────────────────────
EXCLUDE_KEYWORDS=Senior,Lead,Manager,Director,stage,internship,alternance

# ── 📅 Filtres ───────────────────────────────────
MAX_DAYS_OLD=7
SALARY_MIN=35000
SALARY_MAX=55000
MAX_OFFERS_PER_PLATFORM=50

# ── 🤖 Ollama ────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# ── ⚙️ Scraping ───────────────────────────────────
HEADLESS=true
SCRAPE_DELAY=3

# ── 🗄️ Base de données ────────────────────────────
DB_PATH=/home/TON_USER/kazi-data/kazi.db
